datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Seat {
  id          String    @id
  name        String
  zone        String
  status      String    @default("available")
  hourlyRate  Int
  coordX      Float
  coordY      Float
  amenities   String
  description String
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  bookingRef      String   @unique
  seatId          String
  seat            Seat     @relation(fields: [seatId], references: [id])
  zone            String
  durationHours   Int
  preferences     String   @default("[]")
  seatCost        Float
  foodCost        Float
  discount        Float    @default(0)
  totalCost       Float
  dailyCapApplied Boolean  @default(false)
  pin             String
  qrCodeUrl       String
  status          String   @default("confirmed")
  customerName    String
  customerEmail   String
  orderItems      String   @default("[]")
  createdAt       DateTime @default(now())
}

model MenuItem {
  id          String   @id
  name        String
  category    String
  price       Int
  description String
  isPopular   Boolean  @default(false)
  icon        String
  createdAt   DateTime @default(now())
}

model UserProfile {
  id                String   @id @default("user_1")
  credits           Int      @default(320)
  hoursBooked       Int      @default(47)
  totalSaved        Float    @default(1200)
  freeCoffeesReady  Int      @default(2)
  currentTier       String   @default("Gold")
  lifetimePoints    Int      @default(820)
  nextTierPoints    Int      @default(1000)
  updatedAt         DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  type        String
  title       String
  credits     Int
  description String
  date        String
  createdAt   DateTime @default(now())
}

model Rating {
  id          String   @id @default(cuid())
  bookingRef  String?
  wifi        Float
  seating     Float
  noise       Float
  food        Float
  overall     Float
  tags        String   @default("[]")
  feedback    String?
  createdAt   DateTime @default(now())
}
